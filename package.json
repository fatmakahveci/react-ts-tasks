{
  "name": "react-ts-tasks",
  "version": "0.1.0",
  "description": "A responsive task management app built with Next.js, React, TypeScript, and Firebase.",
  "license": "Apache-2.0",
  "author": "fatmakhv",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fatmakahveci/react-ts-tasks.git"
  },
  "homepage": "https://github.com/fatmakahveci/react-ts-tasks#readme",
  "bugs": {
    "url": "https://github.com/fatmakahveci/react-ts-tasks/issues"
  },
  "keywords": [
    "nextjs",
    "react",
    "typescript",
    "firebase",
    "task-manager"
  ],
  "files": [
    ".env.example",
    "eslint.config.mjs",
    "src",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test src/app/lib/task-data.test.ts",
    "test:firebase": "firebase emulators:exec --project demo-focus --only auth,database 'node --test tests/firebase.test.mjs'",
    "emulators": "firebase emulators:start --project demo-focus --only auth,database",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.29.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
